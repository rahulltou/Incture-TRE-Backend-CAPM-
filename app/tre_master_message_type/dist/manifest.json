{
	"_version": "1.83.0",
	"sap.app": {
		"id": "nstremastermessage.tremastermessagetype",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "0.0.2"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:lrop",
			"version": "1.21.0",
			"toolsId": "12bebfec-8be5-40ed-9e81-ec6f477120d1"
		},
		"dataSources": {
			"mainService": {
				"uri": "/service/zTR_Backend_1/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.01"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"intent1": {
					"semanticObject": "TREMaster",
					"action": "displayMessageType",
					"title": "{{appTitle}}",
					"description": "{{appDescription}}"
				},
				"intent-manage": {
					"semanticObject": "TRE",
					"action": "manage",
					"title": "Manage TRE Metadata",
					"icon": "sap-icon://settings"
				}
			},
			"outbounds": {}
		}
	},
	"sap.cloud": {
		"public": true,
		"service": "tre.metadata"
	},
	"sap.ui": {
		"technology": "UI5",
		"fullWidth": false,
		"supportedThemes": [
			"sap_horizon",
			"sap_horizon_dark"
		],
		"icons": {
			"icon": "sap-icon://add-folder",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": false,
		"dependencies": {
			"minUI5Version": "1.145.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.fe.templates": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "nstremastermessage.tremastermessagetype.i18n.i18n",
					"supportedLocales": [
						""
					]
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			},
			"@i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"uri": "i18n/i18n.properties",
				"settings": {
					"supportedLocales": [
						""
					]
				}
			}
		},
		"resources": {
			"css": []
		},
		"routing": {
			"config": {},
			"routes": [
				{
					"pattern": ":?query:",
					"name": "MessageTypesForMetadataList",
					"target": "MessageTypesForMetadataList"
				},
				{
					"pattern": "MessageTypesForMetadata({key}):?query:",
					"name": "MessageTypesForMetadataObjectPage",
					"target": "MessageTypesForMetadataObjectPage"
				}
			],
			"targets": {
				"MessageTypesForMetadataList": {
					"type": "Component",
					"id": "MessageTypesForMetadataList",
					"name": "sap.fe.templates.ListReport",
					"options": {
						"settings": {
							"contextPath": "/MessageTypesForMetadata",
							"variantManagement": "Page",
							"navigation": {
								"MessageTypesForMetadata": {
									"detail": {
										"route": "MessageTypesForMetadataObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable"
									},
									"actions": {
										"loadMetaData1": {
											"press": "nstremastermessage.tremastermessagetype.ext.controller.loadMetaData1.loadMetaData1",
											"visible": true,
											"enabled": true,
											"requiresSelection": true,
											"text": "Load Idoc Metadata"
										}
									}
								}
							},
							"content": {
								"header": {
									"actions": {
										"MessageTypesForMetadataList": {
											"press": "nstremastermessage.tremastermessagetype.ext.controller.MessageTypesForMetadataList.loadMetaData",
											"visible": true,
											"enabled": true,
											"requiresSelection": false,
											"text": "Load Idoc Metadata"
										}
									}
								}
							}
						}
					}
				},
				"MessageTypesForMetadataObjectPage": {
					"type": "Component",
					"id": "MessageTypesForMetadataObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"options": {
						"settings": {
							"editableHeaderContent": false,
							"contextPath": "/MessageTypesForMetadata"
						}
					}
				}
			}
		},
		"flexBundle": false
	},
	"sap.flp": {
		"type": "component",
		"componentProperties": {
			"manifest": "manifest.json"
		}
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.fe": {
		"app": {
			"enableLazyLoading": true
		}
	}
}