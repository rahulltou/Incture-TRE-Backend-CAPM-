{
  "_version": "1.84.0",
  "sap.app": {
    "id": "com.inc.tremasterinbidocerrcodes",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.24.0",
      "toolsId": "0ef5a6c1-c44a-41d8-ab2c-c61d3e581391"
    },
    "dataSources": {
      "mainService": {
        "uri": "/service/zTR_Backend_1/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.01",
          "localUri": "localService/metadata.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "TREErrorCode-manage": {
          "semanticObject": "TREErrorCode",
          "action": "display",
          "title": "{{TREErrorCode-manage.flpTitle}}",
          "icon": "sap-icon://message-warning",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.inc.tremasterinbidocerrcodes.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ErrorCodesList",
          "target": "ErrorCodesList"
        },
        {
          "pattern": "ErrorCodes({key}):?query:",
          "name": "ErrorCodesObjectPage",
          "target": "ErrorCodesObjectPage"
        }
      ],
      "targets": {
        "ErrorCodesList": {
          "type": "Component",
          "id": "ErrorCodesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ErrorCodes",
              "variantManagement": "Page",
              "navigation": {
                "ErrorCodes": {
                  "detail": {
                    "route": "ErrorCodesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "ErrorCodesObjectPage": {
          "type": "Component",
          "id": "ErrorCodesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ErrorCodes"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "ztre.service"
  }
}
