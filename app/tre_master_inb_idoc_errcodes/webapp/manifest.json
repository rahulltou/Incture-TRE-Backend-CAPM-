{
  "_version": "1.83.0",
  "sap.app": {
    "id": "nstremasterinbidocerrcodes.tremasterinbidocerrcodes",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.2"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.21.0",
      "toolsId": "010ce9b5-f0d5-48c8-bcba-790f51f8e95f"
    },
    "dataSources": {
      "mainService": {
        "uri": "/service/zTR_Backend_1/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.01"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "intent1": {
          "semanticObject": "TREMaster",
          "action": "displayErrorCodes",
          "title": "{{appTitle}}",
          "description": "{{appDescription}}"
        },
        "intent-manage": {
          "semanticObject": "TRE",
          "action": "manage",
          "title": "Manage TRE Metadata",
          "icon": "sap-icon://settings"
        }
      },
      "outbounds": {}
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "tre.metadata.errorcodes"
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": false,
    "supportedThemes": [
      "sap_horizon",
      "sap_horizon_dark"
    ],
    "icons": {
      "icon": "sap-icon://error",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.145.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "nstremasterinbidocerrcodes.tremasterinbidocerrcodes.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ErrorCodesList",
          "target": "ErrorCodesList"
        },
        {
          "pattern": "ErrorCodes({key}):?query:",
          "name": "ErrorCodesObjectPage",
          "target": "ErrorCodesObjectPage"
        }
      ],
      "targets": {
        "ErrorCodesList": {
          "type": "Component",
          "id": "ErrorCodesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ErrorCodes",
              "variantManagement": "Page",
              "navigation": {
                "ErrorCodes": {
                  "detail": {
                    "route": "ErrorCodesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "ErrorCodesObjectPage": {
          "type": "Component",
          "id": "ErrorCodesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ErrorCodes"
            }
          }
        }
      }
    }
  },
  "sap.flp": {
    "type": "component",
    "componentProperties": {
      "manifest": "manifest.json"
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
