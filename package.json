{
  "name": "ZTRE_Backend_1",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4.5.1",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "axios": "^1.16.1",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "express": "^4",
    "moment": "^2.29.4",
    "node-cron": "^3.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-tre_master_message_type": "cds watch --open nstremastermessage.tremastermessagetype/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy ZTRE_Backend_1 --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf8 deploy mta_archives/archive.mtar --retries 1",
    "watch-tre_master_inb_idoc_errcodes": "cds watch --open nstremasterinbidocerrcodes.tremasterinbidocerrcodes/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-tre_master_scheduler": "cds watch --open nstremasterscheduler.tremasterscheduler/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-tre_master_message_types": "cds watch --open nstremastermessages.tremastermessagetypes/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "auth": {
        "[development]": {
          "kind": "dummy"
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "multitenancy": false
      },
      "[with-mtx]": {
        "multitenancy": false
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": true,
      "Corrected_Error_EDIDC": {
        "kind": "odata-v2",
        "model": "srv/external/Corrected_Error_EDIDC",
        "[development]": {
          "mock": true
        },
        "[production]": {
          "credentials": {
            "destination": "s4h-210-odata-basic",
            "path": "/sap/opu/odata/sap/ZIDOC_ERROR_REPROCESSING_SRV"
          }
        }
      },
      "ZIDOC_METADATA_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/ZIDOC_METADATA_SRV",
        "[development]": {
          "mock": true
        },
        "[production]": {
          "credentials": {
            "destination": "s4h-210-odata-basic",
            "path": "/sap/opu/odata/sap/ZIDOC_ERROR_REPROCESSING_SRV"
          }
        }
      }
    },
    "profile": "development"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/tre_master_message_type",
    "app/tre_master_inb_idoc_errcodes",
    "app/tre_master_scheduler",
    "app/tre_master_message_types",
    "app/tre_master_message_types"
  ]
}